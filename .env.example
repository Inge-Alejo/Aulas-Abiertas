# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - AULAS ABIERTAS (FACULTAD DE MEDICINA UDEA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTENTICACIÓN ADMINISTRATIVA DIRECTA POR VERCEL (/api/auth)
# ------------------------------------------------------------------------------
# Credenciales seguras para el equipo de Teleducación UdeA sin depender de Firebase Auth.
# Configurar en Vercel Dashboard > Project Settings > Environment Variables:
ADMIN_PASSWORD=
ADMIN_EMAIL=aprendizajes.med@udea.edu.co
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 2. FIREBASE / FIRESTORE (Sincronización en Tiempo Real Global)
# ------------------------------------------------------------------------------
# Colección 'agenda' (documento 'programacion_activa'), 'favoritos_usuario' y 'preguntas_actividades'.
# Permite que las conferencias publicadas se actualicen al instante en cualquier dispositivo.
# Obtenidos en la consola de Firebase (https://console.firebase.google.com/) > Configuración del Proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API (Extractor de Boletines MailerLite y Asistente IA)
# ------------------------------------------------------------------------------
# Clave de API de Google AI Studio (https://aistudio.google.com/).
# En Vercel: Configurar como GEMINI_API_KEY en Project Settings > Environment Variables.
# En desarrollo local: Puedes usar VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. GOOGLE SHEETS (Programación Semanal en Vivo de Respaldo)
# ------------------------------------------------------------------------------
# URL pública de la pestaña "Programacion_publica" publicada como CSV.
# Formato: https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=0&single=true&output=csv
# Si se deja vacía, el sistema usa el dataset oficial verificado local en /data/.
VITE_PUBLIC_SCHEDULE_CSV_URL=
